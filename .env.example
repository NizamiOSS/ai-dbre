# =============================================================================
# AI DBRE — Environment Configuration
# =============================================================================

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- PostgreSQL Connection (agent uses read-only user) ---
PG_HOST=localhost
PG_PORT=5434
PG_DATABASE=dbre_testdb
PG_USER=dbre_agent
PG_PASSWORD=agent_readonly

# --- PostgreSQL Admin Connection (for workload generation only) ---
PG_ADMIN_USER=dbre_admin
PG_ADMIN_PASSWORD=dbre_secret

# --- Agent Settings ---
SLOW_QUERY_THRESHOLD_MS=500
MAX_RESULTS=10

# --- LangSmith (optional, for tracing) ---
# LANGSMITH_API_KEY=lsv2-xxxxx
# LANGSMITH_PROJECT=ai-dbre
# LANGCHAIN_TRACING_V2=true
